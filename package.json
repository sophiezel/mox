{
  "name": "mox",
  "version": "1.1.0",
  "description": "Generic frontend API mock CLI — single proxy, multi catalog, shared rules",
  "bin": {
    "mox": "./bin/mox.js"
  },
  "scripts": {
    "mox": "node ./bin/mox.js",
    "install:local": "bash ./scripts/install.sh",
    "test": "node --require ./test/_isolate-data-root.cjs --test test/*.test.js",
    "test:smoke": "node --require ./test/_isolate-data-root.cjs scripts/run-fixture-smoke.js",
    "test:upstream-e2e": "node --require ./test/_isolate-data-root.cjs --test test/upstream-e2e.test.js",
    "test:all": "npm test && npm run test:smoke && npm run test:upstream-e2e",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 60 node --require ./test/_isolate-data-root.cjs --test test/*.test.js",
    "lint": "eslint bin lib runtime scripts test adapters --max-warnings 50"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@vue/compiler-dom": "^3.5.40",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "json-schema-faker": "^0.5.8",
    "qrcode": "^1.5.4",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^9.39.5"
  },
  "license": "MIT",
  "files": [
    "bin",
    "lib",
    "runtime",
    "scripts",
    "adapters",
    "assets",
    "config",
    "rules",
    "references",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ]
}
