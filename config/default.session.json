{
  "proxy": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 18999,
    "allowOpenProxy": true,
    "missPolicy": "passthrough",
    "blockWritePassthrough": true,
    "injectCaseHeader": "x-mock-case",
    "recordMisses": true,
    "captureScope": "catalog",
    "mode": "mock-lab",
    "captureNoiseSuffixes": [],
    "passthroughHosts": [],
    "trafficMode": "all-mock",
    "mockAllowlist": [],
    "mitm": {
      "enabled": true
    }
  },
  "mock": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3900
  },
  "browser": {
    "autoLaunch": false,
    "startUrl": "http://127.0.0.1:8000",
    "proxyArg": true,
    "trafficGateSeconds": 30
  },
  "dataRetention": {
    "captures": { "maxFiles": 500, "maxAgeDays": 7 },
    "appendLogs": {
      "maxBytes": 20971520,
      "keepRotated": 3,
      "targets": [
        "audit/proxy-access.jsonl",
        "audit/changelog.jsonl",
        "reports/upstream-failures.jsonl",
        "session-start.log"
      ]
    },
    "reports": { "maxAgeDays": 14, "keepPerPrefix": 20 },
    "chromeProfiles": { "maxAgeDays": 14 },
    "orphanServiceDirs": true
  },
  "cors": {
    "allowLocalhost": true,
    "extraOrigins": [],
    "allowCredentials": true,
    "reflectOrigin": true
  },
  "cases": {
    "default": "success",
    "active": {}
  },
  "activeCatalogs": [],
  "activeRules": [],
  "captureMode": "soft"
}
