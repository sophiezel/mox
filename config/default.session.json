{
  "proxy": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 18999,
    "allowOpenProxy": true,
    "missPolicy": "passthrough",
    "blockWritePassthrough": true,
    "injectCaseHeader": "x-mock-case",
    "recordMisses": true,
    "captureScope": "catalog",
    "mode": "mock-lab",
    "captureNoiseSuffixes": [],
    "passthroughHosts": [],
    "trafficMode": "all-mock",
    "mockAllowlist": [],
    "mitm": {
      "enabled": true
    }
  },
  "mock": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3900
  },
  "browser": {
    "autoLaunch": true,
    "startUrl": "http://127.0.0.1:8000",
    "proxyArg": true,
    "trafficGateSeconds": 30
  },
  "cors": {
    "allowLocalhost": true,
    "extraOrigins": [],
    "allowCredentials": true,
    "reflectOrigin": true
  },
  "cases": {
    "default": "success",
    "active": {}
  },
  "activeCatalogs": [],
  "activeRules": [],
  "captureMode": "soft"
}
